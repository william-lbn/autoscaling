FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=768MiB GOPROXY=off
COPY . .
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir /out; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; test "$(cat /out/memory.max)" = 3221225472; sha256sum -c .system-stock-cohort.sha256 >/out/source-check.txt; cp .system-stock-cohort.sha256 /out/actual-source.sha256; set +e; go test -race -count=1 -timeout=180s -json -run '^(TestNormalSystemV3Stock|TestNormalOrdinaryStockUdevManifest|TestNormalSystemV3RequiresOriginalMetadataAssets|TestNormalSystemV3JSONRemainsExact|TestNormalSystemSourceConfigInventory|TestNormalSplitV3Stock|TestNormalSplitV3AssetsBindExactOriginalBytes)' ./pkg/dsga/resourceguard ./vm-builder >/out/test.json 2>/out/test.stderr; echo $? >/out/test.rc; CGO_ENABLED=0 go build -o /out/resource-guard ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.rc; CGO_ENABLED=0 go build -o /out/vm-builder ./vm-builder >/out/builder.log 2>&1; echo $? >/out/builder.rc; GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /out/resource-guard-darwin ./neonvm-daemon/cmd/resource-guard >/out/darwin.log 2>&1; echo $? >/out/darwin.rc; GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /out/vm-builder-darwin ./vm-builder >/out/darwin-builder.log 2>&1; echo $? >/out/darwin-builder.rc
FROM scratch
COPY --from=check /out/ /
