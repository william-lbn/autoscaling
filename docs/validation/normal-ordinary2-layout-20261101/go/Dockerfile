FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=768MiB GOPROXY=off
COPY . .
ARG NONCE
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir -p /out; test "$(cat /sys/fs/cgroup/memory.max)" = 3221225472; test "$(cat /sys/fs/cgroup/cpu.max)" = "300000 100000"; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; sha256sum -c .ordinary-layout-sha256 >/out/actual-copy-verification.txt; cp .ordinary-layout-sha256 /out/compiled-source-sha256.txt; set +e; go test -race -count=1 -timeout=90s -json -run '^TestOrdinaryV2(Directory|FixedAssets)' ./pkg/dsga/resourceguard ./vm-builder >/out/test.json 2>/out/test.stderr; echo $? >/out/u.exitcode; CGO_ENABLED=0 go build -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 go build -o /out/vm-builder.real ./vm-builder >/out/builder.log 2>&1; echo $? >/out/builder.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go test -c -o /out/resourceguard-darwin.test ./pkg/dsga/resourceguard >/out/darwin-resourceguard.log 2>&1; echo $? >/out/darwin-resourceguard.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go test -c -o /out/builder-darwin.test ./vm-builder >/out/darwin-builder.log 2>&1; echo $? >/out/darwin-builder.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_ordinary_v2_layout -o /out/layout-native.test ./pkg/dsga/resourceguard >/out/native-compile.log 2>&1; echo $? >/out/native-compile.exitcode; DSGA_ORDINARY_V2_ASSET_EXPORT=/out/assets go test -count=1 -run ^TestExportOrdinaryV2FixedAssets$ ./vm-builder >/out/asset-export.log 2>&1; echo $? >/out/asset-export.exitcode
FROM scratch
COPY --from=check /out/ /
