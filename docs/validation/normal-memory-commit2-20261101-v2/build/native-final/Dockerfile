FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS test
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=512MiB
COPY . .
ARG NONCE
RUN --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; test "$(cat /sys/fs/cgroup/memory.max)" = 2147483648; mkdir -p /out; ln -s /out /proof; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; sha256sum -c actual-source-sha256.txt >/out/actual-copy-verification.txt; echo 0 >/out/source.exitcode; cp actual-source-sha256.txt /out/compiled-source-sha256.txt; set +e; CGO_ENABLED=0 go test -c -tags=dsga_native_memory_commit2,dsga_native_filesystem_origin,dsga_native_system_lifecycle -o /out/guest-memory.test ./pkg/dsga/resourceguard >/out/guest-compile.stdout 2>/out/guest-compile.stderr; echo $? >/out/guest-compile.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_memory_commit2,dsga_native_initial_lifecycle,dsga_native_memory_origin_wire -o /out/host-memory.test ./pkg/dsga/vmguard >/out/host-compile.stdout 2>/out/host-compile.stderr; echo $? >/out/host-compile.exitcode; if [ -x /out/host-memory.test ] && [ -x /out/guest-memory.test ]; then DSGA_INITIAL_HOST_NATIVE=export-v2 DSGA_INITIAL_HOST_OUTPUT=/proof /out/host-memory.test -test.run=^TestNativeNormalMemoryCommit2Host$ -test.v -test.timeout=30s >/out/host-export.log 2>&1; echo $? >/out/host-export.exitcode; DSGA_MEMORY_COMMIT2_HOST_RUNTIME=/out/host-seed-runtime.json DSGA_SYSTEM_ROLE_ELF=/workspace/fixture/system-role DSGA_SYSTEM_LIFECYCLE_EXPORT=/out/fixture DSGA_FS_GUARD_ELF=/out/guest-memory.test /out/guest-memory.test -test.run=^TestExportNormalMemoryCommit2FilesystemFixture$ -test.v -test.timeout=30s >/out/fixture-export.log 2>&1; echo $? >/out/fixture-export.exitcode; fi; echo 0 >/out/test.exitcode
FROM scratch
COPY --from=test /out/ /
