# syntax=docker/dockerfile:1-labs
FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS build
USER root
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=4 GOMEMLIMIT=1536MiB GOFLAGS=-p=2 GOPROXY=off
WORKDIR /work
COPY . .
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir /out; test "$(cat /sys/fs/cgroup/memory.max)" = 4294967296; test "$(cat /sys/fs/cgroup/cpu.max)" = "400000 100000"; sha256sum -c .trusted-inputs.sha256 >/out/actual-copy-verification.txt; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; cat /sys/fs/cgroup/memory.max >/out/memory.max; go version >/out/go-version.txt; printenv GOMAXPROCS GOMEMLIMIT GOFLAGS >/out/go-env.txt; set +e; go test -p=2 -race -json -count=1 -timeout=120s -run '^(TestTrustedController|TestNormalPgStderr|TestResourceSourceStrictBytesAndBounds)' ./pkg/dsga/resourceguard >/out/test.json 2>/out/test.stderr; echo $? >/out/u.exitcode; go test -p=2 -race -json -count=1 -timeout=90s -run '^TestNormalTrustedController' ./vm-builder >/out/builder-test.json 2>/out/builder-test.stderr; echo $? >/out/builder-u.exitcode; ( CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB go build -p=1 -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB go build -p=1 -o /out/vm-builder.real ./vm-builder >/out/builder.log 2>&1; echo $? >/out/builder.exitcode ) & lane1=$!; ( CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB go test -p=1 -c -ldflags="-s -w" -tags=dsga_native_trusted_control,dsga_native_stock_preparation,dsga_native_ordinary2,dsga_native_role_transfer2,dsga_native_role_service,dsga_native_system_lifecycle -o /out/trusted-guest.test ./pkg/dsga/resourceguard >/out/guest.log 2>&1; echo $? >/out/guest.exitcode; CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB go test -p=1 -c -ldflags="-s -w" -tags=dsga_native_stock_preparation,dsga_native_ordinary2,dsga_native_role_transfer2,dsga_native_memory_commit2,dsga_native_initial_lifecycle,dsga_native_memory_origin_wire -o /out/host-memory.test ./pkg/dsga/vmguard >/out/host.log 2>&1; echo $? >/out/host.exitcode ) & lane2=$!; wait $lane1; wait $lane2; cat /sys/fs/cgroup/cpu.stat >/out/cpu.stat; cat /sys/fs/cgroup/memory.peak >/out/memory.peak; cat /sys/fs/cgroup/io.stat >/out/io.stat; exit 0
FROM scratch
COPY --from=build /out/ /
