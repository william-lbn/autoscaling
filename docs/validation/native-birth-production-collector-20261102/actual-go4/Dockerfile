FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=4 GOMEMLIMIT=1536MiB GOPROXY=off
COPY . .
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir /out; test "$(cat /sys/fs/cgroup/memory.max)" = 4294967296; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; sha256sum -c .joint-source.sha256 >/out/actual-copy-verification.txt; cp .joint-source.sha256 /out/compiled-source.sha256; cat /sys/fs/cgroup/cpu.stat >/out/cpu.stat.before; cat /sys/fs/cgroup/io.stat >/out/io.stat.before; set +e; go test -p 2 -race -count=1 -timeout=120s -json -run '^(TestNativeBirthBuildCollectorExactBytes|TestNativeBirthBuildCollectorRejectsOriginalInputChanges|TestNativeBirthBuildCollectorReaderErrorsNeverDisappear|TestNativeBirthBuildCollectorRecursive64ObjectBoundary)$' ./pkg/dsga/resourceguard >/out/u0.json 2>/out/u0.stderr; echo $? >/out/u0.exitcode; go test -p 2 -race -count=1 -timeout=120s -json -run '^(TestNormalNativeBirthBuildSelectorAndTemplate|TestNormalNativeBirthBuildActualGNUClosureAndExactSystemBytes|TestNormalNativeBirthBuildRejectsUnapprovedRootInputs)$' ./vm-builder >/out/u1.json 2>/out/u1.stderr; echo $? >/out/u1.exitcode; CGO_ENABLED=0 go build -p 2 -o /out/vm-builder ./vm-builder >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -p 2 -o /out/vm-builder-darwin ./vm-builder >/out/darwin.log 2>&1; echo $? >/out/darwin.exitcode; CGO_ENABLED=0 go test -p 2 -c -o /out/native-builder.test ./vm-builder >/out/component-compile.log 2>&1; echo $? >/out/component-compile.exitcode; cat /sys/fs/cgroup/cpu.stat >/out/cpu.stat.after; cat /sys/fs/cgroup/memory.peak >/out/memory.peak; cat /sys/fs/cgroup/io.stat >/out/io.stat.after; cat /sys/fs/cgroup/memory.events >/out/memory.events
FROM scratch
COPY --from=check /out/ /
