FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=3 GOMEMLIMIT=1536MiB GOPROXY=off
COPY . .
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir /out; test "$(cat /sys/fs/cgroup/memory.max)" = 3221225472; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; sha256sum -c .joint-source.sha256 >/out/actual-copy-verification.txt; cp .joint-source.sha256 /out/compiled-source.sha256; set +e; go test -race -count=1 -timeout=120s -json -run '^(TestNormalOrdinaryManagementTLSOriginalTmpfs|TestNormalOrdinaryManagementTLSPartialFailureKeepsTombstone|TestNormalOrdinaryManagementTLSRejectsForeignOrPartialInput)$' ./pkg/dsga/resourceguard >/out/test.json 2>/out/test.stderr; echo $? >/out/u.exitcode; CGO_ENABLED=0 go build -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 go build -o /out/vm-builder.real ./vm-builder >/out/builder.log 2>&1; echo $? >/out/builder.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go test -c -o /out/resourceguard-darwin.test ./pkg/dsga/resourceguard >/out/darwin.log 2>&1; echo $? >/out/darwin.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go test -c -o /out/builder-darwin.test ./vm-builder >/out/builder-darwin.log 2>&1; echo $? >/out/builder-darwin.exitcode
FROM scratch
COPY --from=check /out/ /
