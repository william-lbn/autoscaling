+		return nil, ErrUnknown
+	}
+	source := slot.source
+	if source.g != q.g || source.authority != q.authority || source.filesystem != q.filesystem || source.proof != q.proof || source.originalFS != q.originalFS {
+		return nil, ErrUnknown
+	}
+	return source, nil
