FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS test
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=768MiB DSGA_STOCK_ASSET_FIXTURE=/workspace/.stock-provider-fixture
COPY . .
ARG NONCE
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; test "$(cat /sys/fs/cgroup/memory.max)" = 3221225472; test "$(cat /sys/fs/cgroup/cpu.max)" = "300000 100000"; mkdir /out; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; go version >/out/go-version.txt; sha256sum -c fixture-source-sha256.txt >/out/fixture-copy-verification.txt; cp fixture-source-sha256.txt /out/compiled-fixture-sha256.txt; sha256sum -c actual-source-sha256.txt >/out/actual-copy-verification.txt; echo 0 >/out/source.exitcode; cp actual-source-sha256.txt /out/compiled-source-sha256.txt; set +e; go test -race -count=1 -timeout=180s -json -run "^(TestNormalStockAssets|TestNormalOrdinaryBuild|TestNormalOrdinarySelectedBuild|TestNormalSplitV3)" ./vm-builder >/out/test.json 2>/out/test.stderr; echo $? >/out/test.exitcode; CGO_ENABLED=0 go build -o /out/vm-builder ./vm-builder >/out/cli.stdout 2>/out/cli.stderr; echo $? >/out/cli.exitcode; GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /out/vm-builder-darwin ./vm-builder >/out/darwin.stdout 2>/out/darwin.stderr; echo $? >/out/darwin.exitcode
FROM scratch
COPY --from=test /out/ /
