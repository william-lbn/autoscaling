RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir -p /out; ln -s /out /proof; test "$(cat /sys/fs/cgroup/memory.max)" = 3221225472; test "$(cat /sys/fs/cgroup/cpu.max)" = "300000 100000"; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; sha256sum -c .stock-prep.sha256 >/out/actual-copy-verification.txt; cp .stock-prep.sha256 /out/compiled-source-sha256.txt; set +e; go test -race -count=1 -timeout=90s -json -run '^(TestNormalPgStderr|TestNormalBrokerFreshObservation|TestNormalStockUdevMonitor|TestOrdinaryUdevV2Kernel|TestNormalStockUdevSupervisor|TestNormalOrdinaryStock|TestOrdinaryUdevV2(MaximumGeometry|KindThree|NonEvent|KernelStatic)|TestNormalOrdinaryUdevV2Catalog|TestOrdinaryV2Directory|TestNormalSystemRole(V2|Stdio|Lease|GateV2))' ./pkg/dsga/resourceguard >/out/test.json 2>/out/test.stderr; echo $? >/out/u.exitcode; CGO_ENABLED=0 go build -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 go build -o /out/vm-builder.real ./vm-builder >/out/builder.log 2>&1; echo $? >/out/builder.exitcode; CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go test -c -o /out/resourceguard-darwin.test ./pkg/dsga/resourceguard >/out/darwin.log 2>&1; echo $? >/out/darwin.exitcode; CGO_ENABLED=0 go test -c -ldflags="-s -w" -tags=dsga_native_stock_preparation,dsga_native_ordinary2,dsga_native_role_transfer2,dsga_native_role_service,dsga_native_system_lifecycle -o /out/service.test ./pkg/dsga/resourceguard >/out/native-compile.log 2>&1; echo $? >/out/native-compile.exitcode; CGO_ENABLED=0 go test -c -ldflags="-s -w" -tags=dsga_native_stock_preparation,dsga_native_ordinary2,dsga_native_role_transfer2,dsga_native_memory_commit2,dsga_native_initial_lifecycle,dsga_native_memory_origin_wire -o /out/host-memory.test ./pkg/dsga/vmguard >/out/host-compile.log 2>&1; echo $? >/out/host-compile.exitcode; if test -x /out/service.test && test -x /out/host-memory.test; then DSGA_INITIAL_HOST_NATIVE=export-transfer2 DSGA_INITIAL_HOST_OUTPUT=/proof /out/host-memory.test -test.run=^TestNativeNormalStockUdevPreparationHost$ -test.v -test.timeout=30s >/out/host-export.log 2>&1; echo $? >/out/host-export.exitcode; DSGA_TRANSFER2_HOST_RUNTIME=/out/host-seed-runtime.json DSGA_SYSTEM_ROLE_ELF=/out/service.test DSGA_SYSTEM_LIFECYCLE_EXPORT=/out/fixture DSGA_SERVICE_GUARD_ELF=/out/service.test /out/service.test -test.run=^TestExportNormalStockUdevPreparationSeed$ -test.v -test.timeout=30s >/out/fixture-seed.log 2>&1; echo $? >/out/fixture-seed.exitcode; fi; cat /sys/fs/cgroup/cpu.stat >/out/cpu.stat; cat /sys/fs/cgroup/memory.peak >/out/memory.peak; cat /sys/fs/cgroup/io.stat >/out/io.stat
FROM scratch
