FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=1500MiB GOPROXY=off
COPY . .
ARG NONCE
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir -p /out; test "$(cat /sys/fs/cgroup/memory.max)" = 2147483648; sha256sum -c .role-transfer2-cohort.sha256 >/out/actual-copy-verification.txt; cp .role-transfer2-cohort.sha256 /out/compiled-source-sha256.txt; set +e; GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go test -c -o /out/resourceguard-darwin.test ./pkg/dsga/resourceguard >/out/darwin.log 2>&1; echo $? >/out/darwin.exitcode; GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /out/resource-guard-darwin ./neonvm-daemon/cmd/resource-guard >/out/darwin-cli.log 2>&1; echo $? >/out/darwin-cli.exitcode; CGO_ENABLED=0 go build -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/linux-cli.log 2>&1; echo $? >/out/linux-cli.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_role_transfer2,dsga_native_role_service,dsga_native_system_lifecycle -o /out/service.test ./pkg/dsga/resourceguard >/out/guest-compile.log 2>&1; echo $? >/out/guest-compile.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_role_transfer2,dsga_native_memory_commit2,dsga_native_initial_lifecycle,dsga_native_memory_origin_wire -o /out/host-memory.test ./pkg/dsga/vmguard >/out/host-compile.log 2>&1; echo $? >/out/host-compile.exitcode; CGO_ENABLED=0 go list -json ./pkg/dsga/resourceguard >/out/linux-package-file-selection.json
FROM scratch
COPY --from=check /out/ /
