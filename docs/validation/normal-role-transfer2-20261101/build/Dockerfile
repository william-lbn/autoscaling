FROM 127.0.0.1:5001/neon/pg17-dev-tools@sha256:c940750ed64e18dbe1d5acda5f12b61bb3f1930be149140c54b4e09e62379ba1 AS check
WORKDIR /workspace
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build GOMAXPROCS=2 GOMEMLIMIT=1500MiB GOPROXY=off
COPY . .
ARG NONCE
RUN --network=none --mount=type=cache,id=autoscaling-gomod-amd64-shared-v2,target=/go/pkg/mod,sharing=shared --mount=type=cache,id=autoscaling-gobuild-amd64,target=/root/.cache/go-build,sharing=shared set -eu; mkdir -p /out; ln -s /out /proof; test "$(cat /sys/fs/cgroup/memory.max)" = 2147483648; cat /sys/fs/cgroup/memory.max >/out/memory.max; cat /sys/fs/cgroup/cpu.max >/out/cpu.max; go version >/out/go-version; sha256sum -c .role-transfer2-cohort.sha256 >/out/actual-copy-verification.txt; cp .role-transfer2-cohort.sha256 /out/compiled-source-sha256.txt; set +e; go test -race -count=1 -timeout=120s -json -run '^TestNormalSystemRole(TransferV2.*|KernelTransferRequiresOriginalProof|ServiceFixedFiveDescriptorTransfer|ServiceFixedFourDescriptorTransfer|ServiceOriginalTransferBinding|ServiceGateJournalAndOriginalChain|BrokerDeclarationV3RequiresKernelPrep2|AuthorityDeclarationVersions|BrokerLifetimeDeclaration)$' ./pkg/dsga/resourceguard >/out/test.json 2>/out/test.stderr; echo $? >/out/u.exitcode; CGO_ENABLED=0 go build -o /out/resource-guard.real ./neonvm-daemon/cmd/resource-guard >/out/cli.log 2>&1; echo $? >/out/cli.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_role_transfer2,dsga_native_role_service,dsga_native_system_lifecycle -o /out/service.test ./pkg/dsga/resourceguard >/out/guest-compile.log 2>&1; echo $? >/out/guest-compile.exitcode; CGO_ENABLED=0 go test -c -tags=dsga_native_role_transfer2,dsga_native_memory_commit2,dsga_native_initial_lifecycle,dsga_native_memory_origin_wire -o /out/host-memory.test ./pkg/dsga/vmguard >/out/host-compile.log 2>&1; echo $? >/out/host-compile.exitcode; if test -x /out/service.test && test -x /out/host-memory.test; then DSGA_INITIAL_HOST_NATIVE=export-transfer2 DSGA_INITIAL_HOST_OUTPUT=/proof /out/host-memory.test -test.run=^TestNativeNormalRoleTransferV2Host$ -test.v -test.timeout=30s >/out/host-export.log 2>&1; echo $? >/out/host-export.exitcode; DSGA_TRANSFER2_HOST_RUNTIME=/out/host-seed-runtime.json DSGA_SYSTEM_ROLE_ELF=/out/service.test DSGA_SYSTEM_LIFECYCLE_EXPORT=/out/fixture DSGA_SERVICE_GUARD_ELF=/out/service.test /out/service.test -test.run=^TestExportNormalSystemRoleTransferV2Fixture$ -test.v -test.timeout=30s >/out/fixture-export.log 2>&1; echo $? >/out/fixture-export.exitcode; fi
FROM scratch
COPY --from=check /out/ /
